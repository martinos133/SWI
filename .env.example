# Lokálna SQLite databáza (libSQL). Na produkciu: libsql://<db>.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL="file:./prisma/dev.db"
DATABASE_AUTH_TOKEN=""

# 32+ znakov, používa sa na podpis session a šifrovanie dokladov
APP_SECRET="zmen-ma-na-dlhy-nahodny-retazec-aspon-32-znakov"

# E-maily: bez SMTP_HOST sa správy iba vypisujú do konzoly a ukladajú do EmailLog
SMTP_HOST=""
SMTP_PORT="1025"
MAIL_FROM="Ubytovacie oddelenie <ubytovanie@uniba.example>"
